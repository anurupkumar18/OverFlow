              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Dependency unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "Requires complete subscription search and crowd aggregations. Timed-out, failed-shard, truncated/inexact or malformed subscription hits yield 503 unavailable, never a verified empty alert list. Requests beyond the bounded 1000-subscription result limit remain unavailable."
      }
