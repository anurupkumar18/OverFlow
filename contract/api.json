{
  "openapi": "3.1.0",
  "info": {
    "title": "Overflow API",
    "version": "1.0.0",
    "description": "Stateless service. UTC JSON timestamps end in Z; display and day filters use America/Denver. Search returns max100 rows per page, total all matching. Reranking returns top20 first, subsequent pages use hybrid or lexical and disclose actual mode. Crowd pressure is bookmarks/estimated capacity; likely full means pressure >=1 or >=2 unique reports in last10min. Browser saves never count as crowd interactions."
  },
  "paths": {
    "/api/search": {
      "get": {
        "summary": "Search or browse the official schedule. Unknown crowd state remains eligible with disclosure.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 500
            }
          },
          {
            "name": "day",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date",
              "description": "America/Denver calendar day"
            }
          },
          {
            "name": "track",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 160
            }
          },
          {
            "name": "available",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000,
              "default": 0
            }
          },
          {
            "name": "mode",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "hybrid_rerank",
                "hybrid",
                "bm25",
                "snapshot"
              ]
            },
            "description": "Optional per-result-set search mode ceiling for stable pagination. May select a lower mode than runtime settings; cannot raise or mutate runtime mode. snapshot stays local even during provider recovery. Reset on new search."
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Search"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Dependency unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "When a subsequent page changes mode/order, discard that offset page and refresh offset zero with the new mode ceiling. Pin that ceiling until a new search; do not append incompatible rankings. Each refresh starts once without recursive page retries."
      }
    },
